<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kflix_card_bg"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurações do KFlix"
            android:textColor="@color/kflix_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/dialogSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajuste a URL, o modo de controle e o mouse virtual."
            android:textColor="@color/kflix_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- Seção 1: URL do Servidor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Endereço do Servidor (URL)"
            android:textColor="@color/kflix_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edit_text_tv_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/white"
            android:textColorHint="#88FFFFFF"
            android:hint="http://192.168.1.50:8096"
            android:inputType="textUri|textNoSuggestions"
            android:imeOptions="actionDone"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textSize="15sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/invalid_url_message"
            android:textColor="@color/kflix_error"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Seção 2: Modo de Navegação -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo de Controle do D-Pad"
            android:textColor="@color/kflix_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />

        <RadioGroup
            android:id="@+id/rgNavigationMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="14dp">

            <RadioButton
                android:id="@+id/rbModeNative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nativo Jellyfin TV (Recomendado)"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:focusable="true"
                android:buttonTint="@color/kflix_accent"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use quando o Jellyfin estiver com 'Modo TV' ativado. Não pula itens e navega 1 a 1 de forma fluida."
                android:textColor="@color/kflix_text_secondary"
                android:textSize="12sp"
                android:paddingStart="36dp"
                android:layout_marginBottom="8dp" />

            <RadioButton
                android:id="@+id/rbModeSpatNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Motor KFlix SpatNav"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:focusable="true"
                android:buttonTint="@color/kflix_accent"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Injeta navegação espacial personalizada do app para sites que não têm suporte a controle."
                android:textColor="@color/kflix_text_secondary"
                android:textSize="12sp"
                android:paddingStart="36dp"
                android:layout_marginBottom="4dp" />
        </RadioGroup>

        <!-- Seção 3: Modo Mouse Virtual -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mouse Virtual (Ponteiro na TV)"
            android:textColor="@color/kflix_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <CheckBox
            android:id="@+id/cbVirtualMouse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ativar Modo Mouse Virtual"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:focusable="true"
            android:buttonTint="@color/kflix_accent"
            android:paddingStart="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exibe uma seta de mouse nativa na tela controlada pelo D-Pad. Pressionar OK clica no elemento apontado."
            android:textColor="@color/kflix_text_secondary"
            android:textSize="12sp"
            android:paddingStart="36dp"
            android:layout_marginBottom="18dp" />

        <!-- Botões de Ação -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_tv_secondary_selector"
                android:text="@string/btn_cancel"
                android:textColor="@color/white"
                android:focusable="true"
                android:paddingStart="22dp"
                android:paddingEnd="22dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/btn_tv_selector"
                android:text="Salvar e Aplicar"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:focusable="true"
                android:paddingStart="26dp"
                android:paddingEnd="26dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
